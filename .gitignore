# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Data and experiment artifacts
# El contenido de data/ se ignora, pero los .gitkeep se versionan para que la
# estructura exista en un clon limpio. `data/` a secas no serviria: git no
# desciende en un directorio excluido, asi que la reinclusion no llegaria.
data/**
!data/**/
!data/**/.gitkeep
mlruns/
*.parquet
!reports/**/*.parquet

# Model checkpoints
*.ckpt
*.pt
*.pth
*.h5
*.pkl
*.joblib
checkpoints/

# Notebook outputs
.ipynb_checkpoints/
*.nbconvert.ipynb

# Streamlit secrets
.streamlit/secrets.toml

# Testing / linting / type checking caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Environment variables
.env
.env.*

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Personal Configurations
.claude/
PLAN_PROYECTO.md